# Copier ce fichier sur le serveur staging, sous le nom `.env`, à côté de
# docker-compose.staging.yml (ex. ~/infirmo/.env) — voir infra/deploy/README.md.
#
# Ce fichier n'est JAMAIS commité avec de vraies valeurs (voir infra/.gitignore :
# `.env.*` est ignoré, seuls les `*.example` sont versionnés).
#
# Rappel : environnement staging = hébergement Docker non-HDS. Données
# SYNTHÉTIQUES UNIQUEMENT — aucune donnée de santé réelle ici tant que
# l'hébergement n'est pas certifié HDS (AGENTS.md §5, voir infra/hds/README.md).

POSTGRES_USER=infirmo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=infirmo

# Images publiées sur GHCR par le job build-push de deploy-staging.yml
# (INF-13). <owner>/<repo> correspond au dépôt GitHub en minuscules (voir
# l'étape "Nom d'image en minuscules" du workflow pour le calcul exact).
BACKEND_IMAGE=ghcr.io/epitechmscpropromo2027/t-esp-800-project-100856-ncy_infirmo/backend:develop
IA_IMAGE=ghcr.io/epitechmscpropromo2027/t-esp-800-project-100856-ncy_infirmo/ia:develop

# Nom de domaine du serveur staging, utilisé par Caddy pour le reverse proxy
# et le certificat TLS automatique. Le DNS doit déjà pointer vers le serveur
# avant le premier démarrage.
STAGING_DOMAIN=staging.infirmo.example

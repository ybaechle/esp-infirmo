# Copier ce fichier vers `.env` avant de lancer `docker compose up` :
#   cp .env.example .env
#
# `.env` est ignoré par git (voir .gitignore racine) : ne JAMAIS committer de
# vraies valeurs, même en local. Ces identifiants ne servent qu'à la base
# PostgreSQL locale de développement, avec des données synthétiques
# uniquement (aucune donnée de santé réelle hors environnement HDS —
# voir AGENTS.md et la skill hds-hosting).

POSTGRES_USER=infirmo
POSTGRES_PASSWORD=change-me
POSTGRES_DB=infirmo

# Port hôte de l'API backend (décommenter si 8000 est déjà pris).
# BACKEND_PORT=8000

# --- Monitoring (INF-15, profil "monitoring" — docker compose --profile monitoring up -d) ---
# Ports hôte de Prometheus / Grafana (décommenter si les défauts sont pris).
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3001

# Requis pour démarrer le service grafana (pas de valeur par défaut).
# Mot de passe local uniquement, à changer avant tout usage partagé.
GRAFANA_ADMIN_PASSWORD=change-me

# Démonstration locale synthétique : identifiants publics, jamais en production.
INFIRMO_DEMO_EMAIL=demo@infirmo.example
INFIRMO_DEMO_PASSWORD=Infirmo-demo-2026!
WEB_PORT=8080

# --- Chiffrement des données de santé (backend /api/v1) ---
# Trousseau AES-256 : `identifiant:clé_base64`, séparés par des virgules ; la première clé chiffre,
# toutes déchiffrent (rotation = ajouter la nouvelle en tête). Générer une clé :
#   python -c "import base64,os;print('k1:'+base64.b64encode(os.urandom(32)).decode())"
# Vide par défaut : sans clé, l'API refuse de stocker ces données (503) au lieu de les écrire en clair.
# Ne JAMAIS committer une vraie clé ni réutiliser celle d'un autre environnement.
INFIRMO_ENCRYPTION_KEYS=
